APP_ENV=local
APP_URL=http://127.0.0.1:8000
DB_HOST=127.0.0.1
DB_NAME=overgrace
DB_USER=root
DB_PASS=
JWT_SECRET=troque-por-uma-chave-longa-e-segura
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com

# Reserva de estoque durante o checkout/pagamento
STOCK_RESERVATION_MINUTES=30


FREE_SHIPPING_MIN=299.00

# Mercado Pago
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Configure a URL pública do webhook no painel do Mercado Pago:
# APP_URL + /api/webhooks/mercadopago

# Chave usada para criptografar senhas/tokens salvos no banco.
# Use uma chave longa e diferente do ambiente de desenvolvimento.
APP_ENCRYPTION_KEY=

# Notificações: 1 envia logo após o evento; 0 usa somente o worker/cron.
NOTIFICATION_SYNC_SEND=1
